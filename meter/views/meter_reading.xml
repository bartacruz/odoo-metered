<odoo>
    <record model="ir.ui.view" id="meter_reading_list">
      <field name="name">Meter Reading List View</field>
      <field name="model">meter.reading</field>
      <field name="arch" type="xml">
        <list>
          <field name="meter_id" />
          <field name="date" />
          <field name="value" />
        </list>
      </field>
    </record>

    <record model="ir.ui.view" id="meter_reading_form">
      <field name="name">Meter Reading Form View</field>
      <field name="model">meter.reading</field>
      <field name="arch" type="xml">
        <form>
          <header></header>
          <sheet>
            <div name="button_box" class="oe_button_box"></div>
            <group>
              <field name="meter_id" />
              <field name="date" />
              <field name="value" />
            </group>
          </sheet>
        </form>
      </field>
    </record>

    <record model="ir.actions.act_window" id="action_meter_reading">
      <field name="name">Meter Readings</field>
      <field name="res_model">meter.reading</field>
      <field name="view_mode">list,form</field>
      <field name="help">Manage your meters.</field>
    </record>
</odoo>
