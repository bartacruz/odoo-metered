<odoo>

    <record model="ir.ui.view" id="meter_list_inherit">
        <field name="name">Meter List View</field>
        <field name="inherit_id" ref="meter.meter_list" />
        <field name="model">meter</field>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="contract_id" optional="show" />
            </field>
        </field>
    </record>
    <record model="ir.ui.view" id="meter_form_inherit">
        <field name="name">Meter List View</field>
        <field name="inherit_id" ref="meter.meter_form" />
        <field name="model">meter</field>
        <field name="arch" type="xml">
            <div name="button_box" class="oe_button_box" position="inside">
                <button
                    class="oe_stat_button"
                    type="object"
                    name="action_open_contracts"
                    icon="fa-file-o"
                >
                    <field string="Contracts" name="contracts_count" widget="statinfo" />
                </button>
            </div>
            <field name="partner_id" position="after">
                <field name="contract_id" optional="show" />
            </field>
        </field>
    </record>
</odoo>
